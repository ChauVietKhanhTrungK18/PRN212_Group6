<Window x:Class="Task_Management_System.UpdateProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Profile" Height="398" Width="488" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Background="#f4f6fa" Margin="20">
        <StackPanel Margin="10,20,10,20">
            <TextBlock Text="Update Profile" FontSize="24" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <TextBlock Text="Full Name:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFullName" Height="30" Margin="0,0,0,15"/>

            <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" Height="30" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Save Changes" Width="120" Height="35" Margin="10" Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="btnSave_Click"/>
                <Button Content="Cancel" Width="120" Height="35" Margin="10" Background="#f44336" Foreground="White" FontWeight="Bold" Click="btnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window> 