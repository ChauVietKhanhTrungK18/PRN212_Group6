<Window x:Class="Task_Management_System.UpdateProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Profile" Height="250" Width="400">
    <Grid Background="#f4f6fa" Margin="0">
        <Border Background="#fff" CornerRadius="12" Padding="24" Margin="20">
            <StackPanel>
                <TextBlock Text="Update Profile" FontSize="22" FontWeight="Bold" Foreground="#2d3a4a" Margin="0,0,0,18"/>
                <TextBlock Text="Full Name"/>
                <TextBox x:Name="txtFullName" Margin="0,0,0,10"/>
                <TextBlock Text="Email"/>
                <TextBox x:Name="txtEmail" Margin="0,0,0,18"/>
                <Button Content="Save" x:Name="btnSave" Height="36" Click="btnSave_Click" Background="#0078d7" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 