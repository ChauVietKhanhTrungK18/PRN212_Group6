<Window x:Class="Task_Management_System.MemberDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member Dashboard" Height="650" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid Background="#f4f6fa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Sidebar -->
        <StackPanel Background="#232946" Grid.Column="0" VerticalAlignment="Stretch">
            <TextBlock Text="Task Manager" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20,30,0,30"/>
            <Button x:Name="btnDashboard" Content="Dashboard" Margin="10,0,10,10" Height="44" Click="btnDashboard_Click"/>
            <Button x:Name="btnMyProjects" Content="My Projects" Margin="10,0,10,10" Height="44" Click="btnMyProjects_Click"/>
            <Button x:Name="btnMyTasks" Content="My Tasks" Margin="10,0,10,10" Height="44" Click="btnMyTasks_Click"/>
            <Button x:Name="btnNotifications" Content="Notifications" Margin="10,0,10,10" Height="44" Click="btnNotifications_Click"/>
            <Button x:Name="btnProfile" Content="Profile" Margin="10,0,10,10" Height="44" Click="btnProfile_Click"/>
            <StackPanel VerticalAlignment="Bottom" Margin="10,40,10,10">
                <TextBlock Text="Welcome!" Foreground="#b8c1ec" FontSize="14"/>
            </StackPanel>
        </StackPanel>
        <!-- Main Content -->
        <Border Grid.Column="1" Background="#fff" CornerRadius="16" Margin="20">
            <ScrollViewer>
                <StackPanel x:Name="MyProjectsPanel" Visibility="Collapsed" Margin="20">
                    <TextBlock Text="Managed Projects" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgManagedProjects" AutoGenerateColumns="False" Margin="0,0,0,20" IsReadOnly="True" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project Name" Binding="{Binding ProjectName}" Width="2*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*"/>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=MM/dd/yyyy}" Width="*"/>
                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat=MM/dd/yyyy}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Manage Members" Margin="2" Padding="6,2" Click="btnManageMembers_Click"/>
                                            <Button Content="Assign Task" Margin="2" Padding="6,2" Click="btnAssignTask_Click"/>
                                            <Button Content="Edit" Margin="2" Padding="6,2" Click="btnEditProject_Click"/>
                                            <Button Content="Delete" Margin="2" Padding="6,2" Click="btnDeleteProject_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Participated Projects" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
                    <DataGrid x:Name="dgParticipatedProjects" AutoGenerateColumns="False" IsReadOnly="True" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project Name" Binding="{Binding ProjectName}" Width="2*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*"/>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=MM/dd/yyyy}" Width="*"/>
                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat=MM/dd/yyyy}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <ContentControl x:Name="MainContent"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window> 