<Window x:Class="Task_Management_System.ManageAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Accounts" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#f4f6fa">
        <!-- Main content -->
        <StackPanel Margin="20">
            <TextBlock Text="Manage Accounts" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Filter and search -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" >
                <!-- Search -->
                <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                    <TextBlock Text="Search by Username/Email:" FontWeight="Bold"/>
                    <TextBox x:Name="txtSearch" Width="200" Height="30"
                             TextChanged="txtSearch_TextChanged"/>
                </StackPanel>

                <!-- Role filter -->
                <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                    <TextBlock Text="Filter by Role:" FontWeight="Bold"/>
                    <ComboBox x:Name="cbRoleFilter" Width="150"
                              SelectionChanged="cbRoleFilter_SelectionChanged"
                              DisplayMemberPath="RoleName" SelectedValuePath="RoleId"/>
                </StackPanel>

                <!-- Status filter -->
                <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                    <TextBlock Text="Filter by Status:" FontWeight="Bold"/>
                    <ComboBox x:Name="cbStatusFilter" Width="150"
                              SelectionChanged="cbStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="Clear Filters" Width="120" VerticalAlignment="Bottom"
                        Click="btnClearFilter_Click"/>
            </StackPanel>

            <!-- User DataGrid -->
            <DataGrid x:Name="dgUsers" AutoGenerateColumns="False"
                      Height="420" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="60"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                    <!-- Role chỉ hiển thị, không chỉnh trực tiếp -->
                    <DataGridTextColumn Header="Role" Binding="{Binding Role.RoleName}" Width="150"/>
                    <DataGridCheckBoxColumn Header="Inactive?" Binding="{Binding IsDeleted}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" >
                <Button Content="Activate" Width="100" Click="BtnActivate_Click"/>
                <Button Content="Deactivate" Width="100" Click="BtnDeactivate_Click"/>
                <Button Content="Change Role" Width="120" Click="BtnChangeRole_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Popup for Change Role -->
        <Border x:Name="PopupChangeRole"
                Background="White"
                CornerRadius="8"
                BorderBrush="Gray" BorderThickness="1"
                Padding="20"
                Width="300" Height="180"
                Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Panel.ZIndex="999">
            <StackPanel>
                <TextBlock Text="Select new role:" FontWeight="Bold" Margin="0,0,0,10"/>
                <ComboBox x:Name="cbPopupRoles" DisplayMemberPath="RoleName" SelectedValuePath="RoleId" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <Button Content="Cancel" Width="80" Click="BtnCancelPopup_Click"/>
                    <Button Content="Save" Width="80" Click="BtnSavePopup_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
