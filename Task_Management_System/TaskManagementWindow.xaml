<Window x:Class="Task_Management_System.TaskManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Management" Height="700" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF9800" Padding="15,10" CornerRadius="5,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Task Management" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Close" Padding="15,5" Background="#F44336" Foreground="White" BorderThickness="0" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Task List -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Task List Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Task List" FontSize="16" FontWeight="Bold"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Refresh" Padding="10,5" Margin="0,0,5,0" Background="#2196F3" Foreground="White" BorderThickness="0" Click="BtnRefresh_Click"/>
                                <Button Content="Add New Task" Padding="10,5" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="BtnAddTask_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Task DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="dgTasks" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgTasks_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding TaskId}" Width="50"/>
                            <DataGridTextColumn Header="Task Name" Binding="{Binding TaskName}" Width="200"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Assignee" Binding="{Binding Assignee.FullName}" Width="150"/>
                            <DataGridTextColumn Header="Project" Binding="{Binding Project.ProjectName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Action Panel -->
            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" Width="320">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Action Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10">
                        <TextBlock Text="Actions" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" Margin="10">
                        <Button x:Name="btnEditTask" Content="Edit Task" Height="40" Margin="0,5" FontSize="14" Background="#FF9800" Foreground="White" BorderThickness="0" Click="BtnEditTask_Click" IsEnabled="False"/>
                        <Button x:Name="btnDeleteTask" Content="Delete Task" Height="40" Margin="0,5" FontSize="14" Background="#F44336" Foreground="White" BorderThickness="0" Click="BtnDeleteTask_Click" IsEnabled="False"/>
                        <Button x:Name="btnAssignTask" Content="Assign Task" Height="40" Margin="0,5" FontSize="14" Background="#2196F3" Foreground="White" BorderThickness="0" Click="BtnAssignTask_Click" IsEnabled="False"/>
                        <Button x:Name="btnUpdateStatus" Content="Update Status" Height="40" Margin="0,5" FontSize="14" Background="#9C27B0" Foreground="White" BorderThickness="0" Click="BtnUpdateStatus_Click" IsEnabled="False"/>
                        <Separator Margin="0,20"/>
                        <TextBlock Text="Task Details" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Task Name:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTaskName" Text="-" Margin="0,0,0,10"/>
                        <TextBlock Text="Description:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtDescription" Text="-" Margin="0,0,0,10"/>
                        <TextBlock Text="Due Date:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtDueDate" Text="-" Margin="0,0,0,10"/>
                        <TextBlock Text="Status:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtStatus" Text="-" Margin="0,0,0,10"/>
                        <TextBlock Text="Assignee:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtAssignee" Text="-" Margin="0,0,0,10"/>
                        <TextBlock Text="Project:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtProject" Text="-" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10,5" CornerRadius="0,0,5,5">
            <TextBlock x:Name="txtStatusBar" Text="Ready" Foreground="#666666"/>
        </Border>
    </Grid>
</Window> 