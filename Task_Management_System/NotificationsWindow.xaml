<Window x:Class="Task_Management_System.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        xmlns:converters="clr-namespace:Task_Management_System.Converters"
        mc:Ignorable="d"
        Title="Notifications" Height="600" Width="800">
    
    <Window.Resources>
        <converters:ReadStatusConverter x:Key="ReadStatusConverter"/>
    </Window.Resources>
    
    <Grid Background="#f4f6fa" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Notifications" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtUserInfo" Text="User: " FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <TextBox x:Name="txtSearch" Width="300" Height="30" TextChanged="txtSearch_TextChanged" 
                         VerticalAlignment="Center" Margin="0,0,20,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <ComboBox x:Name="cbFilter" Width="150" Height="30" SelectionChanged="cbFilter_SelectionChanged">
                    <ComboBoxItem Content="All Notifications" IsSelected="True"/>
                    <ComboBoxItem Content="Unread Only"/>
                    <ComboBoxItem Content="Read Only"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0">
                <TextBlock Text="Sort By:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <ComboBox x:Name="cbSortBy" Width="150" Height="30" SelectionChanged="cbSortBy_SelectionChanged">
                    <ComboBoxItem Content="Date (Newest)" IsSelected="True"/>
                    <ComboBoxItem Content="Date (Oldest)"/>
                    <ComboBoxItem Content="Unread First"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Notifications List -->
        <DataGrid x:Name="dgNotifications" Grid.Row="2" AutoGenerateColumns="False" 
                  IsReadOnly="True" SelectionMode="Single" 
                  GridLinesVisibility="All" HeadersVisibility="All"
                  AlternatingRowBackground="#f8f9fa" RowBackground="White"
                  MouseDoubleClick="dgNotifications_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Fill="{Binding IsRead, Converter={StaticResource ReadStatusConverter}}" 
                                     Width="10" Height="10" Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="400"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateCreated, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Mark as Read" Width="120" Height="35" Margin="5" 
                    Background="#28a745" Foreground="White" Click="BtnMarkAsRead_Click"/>
            <Button Content="Mark All as Read" Width="140" Height="35" Margin="5" 
                    Background="#17a2b8" Foreground="White" Click="BtnMarkAllAsRead_Click"/>
            <Button Content="Delete" Width="120" Height="35" Margin="5" 
                    Background="#dc3545" Foreground="White" Click="BtnDelete_Click"/>
            <Button Content="Refresh" Width="120" Height="35" Margin="5" 
                    Background="#6c757d" Foreground="White" Click="BtnRefresh_Click"/>
        </StackPanel>
    </Grid>
</Window> 