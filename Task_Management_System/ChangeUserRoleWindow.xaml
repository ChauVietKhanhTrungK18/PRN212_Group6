<Window x:Class="Task_Management_System.ChangeUserRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change User Role" Height="350" Width="450" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF9800" Padding="15,10" CornerRadius="5,5,0,0">
            <TextBlock Text="Change User Role" 
                       FontSize="18" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Form Content -->
        <StackPanel Grid.Row="1" Margin="0,20">
            <!-- User Info -->
            <TextBlock Text="User:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtUserName" Text="User Name" 
                       FontWeight="Bold" Margin="0,0,0,20" Foreground="#2196F3"/>

            <!-- Current Role -->
            <TextBlock Text="Current Role:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtCurrentRole" Text="Current Role" 
                       FontWeight="Bold" Margin="0,0,0,20" Foreground="#FF9800"/>

            <!-- New Role Selection -->
            <TextBlock Text="New Role *" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cboNewRole" Height="30" Margin="0,0,0,15" 
                      FontSize="14" DisplayMemberPath="RoleName"/>

            <!-- Role Description -->
            <TextBlock Text="Role Description:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtRoleDescription" Text="Role description will appear here" 
                       Margin="0,0,0,20" TextWrapping="Wrap" Foreground="#666666"/>

            <!-- Validation Messages -->
            <TextBlock x:Name="txtValidation" Foreground="Red" FontWeight="Bold" 
                       Margin="0,0,0,10" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10" CornerRadius="0,0,5,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnSave" Content="Save Changes" Width="120" Height="35" 
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Margin="0,0,10,0" Click="BtnSave_Click"/>
                <Button x:Name="btnCancel" Content="Cancel" Width="100" Height="35" 
                        Background="#F44336" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 