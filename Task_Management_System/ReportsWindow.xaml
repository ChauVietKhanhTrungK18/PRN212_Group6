<Window x:Class="Task_Management_System.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Reports &amp; Progress" Height="700" Width="1000">
    <Grid Background="#f4f6fa" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reports &amp; Progress" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtUserName" Text="User: " FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="txtProjectName" Text="Project: " FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Project Selection -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Select Project:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <ComboBox x:Name="cbProjects" Width="300" Height="30" SelectionChanged="cbProjects_SelectionChanged"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Generate Report" Width="150" Height="30" 
                    Background="#28a745" Foreground="White" Click="BtnGenerateReport_Click"/>
        </Grid>

        <!-- Report Content -->
        <TabControl Grid.Row="2">
            <!-- Project Progress Tab -->
            <TabItem Header="Project Progress">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Project Overview" Margin="0,0,0,20">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Total Tasks" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalTasks" Text="0" FontSize="24" HorizontalAlignment="Center" Margin="0,5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Completed Tasks" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtCompletedTasks" Text="0" FontSize="24" HorizontalAlignment="Center" Margin="0,5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="In Progress" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtInProgressTasks" Text="0" FontSize="24" HorizontalAlignment="Center" Margin="0,5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="Not Started" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtNotStartedTasks" Text="0" FontSize="24" HorizontalAlignment="Center" Margin="0,5"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Progress Chart" Margin="0,0,0,20">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Completion Rate:" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ProgressBar x:Name="pbCompletion" Grid.Row="1" Height="30" Margin="0,0,0,5"/>
                                <TextBlock x:Name="txtCompletionRate" Text="0%" HorizontalAlignment="Center"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Task Status Distribution" Margin="0,0,0,20">
                            <DataGrid x:Name="dgStatusDistribution" AutoGenerateColumns="False" Height="200" 
                                      IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="100"/>
                                    <DataGridTextColumn Header="Percentage" Binding="{Binding Percentage}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Team Performance Tab -->
            <TabItem Header="Team Performance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Member Performance" Margin="0,0,0,20">
                            <DataGrid x:Name="dgMemberPerformance" AutoGenerateColumns="False" Height="300" 
                                      IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Member Name" Binding="{Binding MemberName}" Width="200"/>
                                    <DataGridTextColumn Header="Total Assigned" Binding="{Binding TotalAssigned}" Width="120"/>
                                    <DataGridTextColumn Header="Completed" Binding="{Binding Completed}" Width="100"/>
                                    <DataGridTextColumn Header="In Progress" Binding="{Binding InProgress}" Width="100"/>
                                    <DataGridTextColumn Header="Not Started" Binding="{Binding NotStarted}" Width="100"/>
                                    <DataGridTextColumn Header="Completion Rate" Binding="{Binding CompletionRate}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Performance Summary" Margin="0,0,0,20">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Top Performer" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTopPerformer" Text="-" HorizontalAlignment="Center" Margin="0,5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Average Completion Rate" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtAvgCompletionRate" Text="0%" HorizontalAlignment="Center" Margin="0,5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Total Team Members" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalMembers" Text="0" HorizontalAlignment="Center" Margin="0,5"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Detailed Reports Tab -->
            <TabItem Header="Detailed Reports">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="Task Details" Margin="0,0,0,20">
                            <DataGrid x:Name="dgTaskDetails" AutoGenerateColumns="False" Height="300" 
                                      IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task Name" Binding="{Binding TaskName}" Width="200"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Assigned To" Binding="{Binding AssignedTo}" Width="150"/>
                                    <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, StringFormat=dd/MM/yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="Export Options" Margin="0,0,0,20">
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <Button Content="Export to CSV" Width="120" Height="30" Margin="5" 
                                        Background="#17a2b8" Foreground="White" Click="BtnExportCSV_Click"/>
                                <Button Content="Export to PDF" Width="120" Height="30" Margin="5" 
                                        Background="#dc3545" Foreground="White" Click="BtnExportPDF_Click"/>
                                <Button Content="Print Report" Width="120" Height="30" Margin="5" 
                                        Background="#6c757d" Foreground="White" Click="BtnPrintReport_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window> 