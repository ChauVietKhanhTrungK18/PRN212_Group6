<Window x:Class="Task_Management_System.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Window" Height="480" Width="900"
         WindowStartupLocation="CenterScreen">
    <Grid Background="#f4f6fa" Margin="0,0,0,-125">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Title and Logout Button -->
        <Grid Grid.Row="0" Margin="30,25,30,10">
            <TextBlock Text="Admin Dashboard" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#2d3a4a" 
                       VerticalAlignment="Center"/>

            <Button Content="Logout" 
                    Width="100" 
                    Height="35"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#e74c3c"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnLogout_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#c0392b"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Original Content -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="30,0,30,20">
            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,30" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Border Background="#fff" CornerRadius="16" Margin="10" Padding="24" BorderBrush="#0078d7" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Members" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalMembers" FontSize="36" FontWeight="Bold" Foreground="#0078d7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#fff" CornerRadius="16" Margin="10" Padding="24" BorderBrush="#43b581" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Projects" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalProjects" FontSize="36" FontWeight="Bold" Foreground="#43b581" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#fff" CornerRadius="16" Margin="10" Padding="24" BorderBrush="#fbbc05" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tasks" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalTasks" FontSize="36" FontWeight="Bold" Foreground="#fbbc05" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#fff" CornerRadius="16" Margin="10" Padding="24" BorderBrush="#e74c3c" BorderThickness="2">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Notifications" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalNotifications" FontSize="36" FontWeight="Bold" Foreground="#e74c3c" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Background="#fff" CornerRadius="12" Padding="24" Margin="0,20,0,0">
                <StackPanel>
                    <Button x:Name="btnManageAccounts" Content="Account Management" Height="48" FontSize="18" Background="#0078d7" Foreground="White" BorderThickness="0" Margin="0,0,0,10" Click="btnManageAccounts_Click"/>
                </StackPanel>
            </Border>
            <Border Background="#fff" CornerRadius="12" Padding="24" Margin="0,10,0,0">
                <StackPanel RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-0.297"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Software Information" FontWeight="Bold" FontSize="20" Height="74"/>
                    <TextBlock Text="Task Management System v1.0" FontSize="14"/>
                    <TextBlock Text="Contact: group6@example.com" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>