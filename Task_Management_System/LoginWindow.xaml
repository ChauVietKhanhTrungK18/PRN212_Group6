<Window x:Class="Task_Management_System.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="650" Width="650" 
        MinHeight="600" MinWidth="550" MaxHeight="800" MaxWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" Background="Transparent" 
        AllowsTransparency="True" WindowStyle="None">

    <Window.Resources>
        <!-- Glass Effect Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="White" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#80FFFFFF" Offset="0"/>
                        <GradientStop Color="#40FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>

        <!-- Animated Input Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Light"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="White" Opacity="0.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Light"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="White" Opacity="0.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Floating Label Style -->
        <Style x:Key="FloatingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Light"/>
            <Setter Property="Foreground" Value="#B0FFFFFF"/>
            <Setter Property="Margin" Value="5,0,0,5"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>

        <!-- Gradient Button Style -->
        <Style x:Key="GradientButton" TargetType="Button">
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" Direction="270" 
                                                ShadowDepth="3" BlurRadius="15" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#60000000" Direction="270" 
                                                        ShadowDepth="5" BlurRadius="20" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Light"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#60FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="White" Opacity="0.1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Animated Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#667eea" Offset="0"/>
                <GradientStop Color="#764ba2" Offset="0.5"/>
                <GradientStop Color="#f093fb" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Floating Particles Effect -->
        <Canvas ClipToBounds="True">
            <Ellipse Width="100" Height="100" Fill="#20FFFFFF" Canvas.Left="80" Canvas.Top="80">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="particle1"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="particle1" 
                                               Storyboard.TargetProperty="Y"
                                               From="0" To="-20" Duration="0:0:3"
                                               AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="particle1" 
                                               Storyboard.TargetProperty="X"
                                               From="0" To="10" Duration="0:0:4"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <Ellipse Width="60" Height="60" Fill="#15FFFFFF" Canvas.Right="120" Canvas.Top="200">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="particle2"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="particle2" 
                                               Storyboard.TargetProperty="Y"
                                               From="0" To="15" Duration="0:0:4"
                                               AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="particle2" 
                                               Storyboard.TargetProperty="X"
                                               From="0" To="-15" Duration="0:0:3"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <Ellipse Width="80" Height="80" Fill="#10FFFFFF" Canvas.Left="420" Canvas.Bottom="100">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="particle3"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="particle3" 
                                               Storyboard.TargetProperty="Y"
                                               From="0" To="-25" Duration="0:0:5"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Canvas>

        <!-- Main Glass Card with responsive layout -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="480" MaxHeight="600">
            <Border Style="{StaticResource GlassCard}" 
                    Width="420" 
                    Height="550"
                    Padding="50">
                <Border.Effect>
                    <DropShadowEffect Color="#40000000" Direction="270" 
                                    ShadowDepth="10" BlurRadius="30" Opacity="0.3"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center">
                    <!-- Logo/Icon Area -->
                    <Ellipse Width="60" Height="60" 
                            Margin="0,0,0,25"
                            HorizontalAlignment="Center">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#80FFFFFF" Offset="0"/>
                                <GradientStop Color="#40FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#30000000" Direction="270" 
                                            ShadowDepth="3" BlurRadius="10" Opacity="0.2"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Welcome Text -->
                    <TextBlock Text="Welcome Back" 
                              FontSize="24" 
                              FontFamily="Segoe UI Light"
                              FontWeight="Light"
                              Foreground="White"
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,5"/>

                    <TextBlock Text="Sign in to continue" 
                              FontSize="13" 
                              FontFamily="Segoe UI Light"
                              Foreground="#B0FFFFFF"
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,25"/>

                    <!-- Username Field -->
                    <TextBlock Text="USERNAME" Style="{StaticResource FloatingLabel}"/>
                    <TextBox x:Name="txtUsername" 
                            Style="{StaticResource ModernTextBox}"
                            Margin="0,0,0,15"/>

                    <!-- Password Field -->
                    <TextBlock Text="PASSWORD" Style="{StaticResource FloatingLabel}"/>
                    <PasswordBox x:Name="txtPassword" 
                                Style="{StaticResource ModernPasswordBox}"
                                Margin="0,0,0,20"/>

                    <!-- Login Button -->
                    <Button Content="SIGN IN" 
                           Click="BtnLogin_Click" 
                           Style="{StaticResource GradientButton}"
                           Margin="0,0,0,12"/>

                    <!-- Divider -->
                    <Border Height="1" 
                           Background="#30FFFFFF" 
                           Margin="15,6,15,6"/>

                    <!-- Register Button -->
                    <Button Content="Create New Account" 
                           Click="BtnRegister_Click" 
                           Style="{StaticResource GhostButton}"
                           Margin="0,6,0,0"/>

                    <!-- Footer -->
                    <TextBlock Text="Task Management System" 
                              FontSize="10" 
                              FontFamily="Segoe UI Light"
                              Foreground="#80FFFFFF"
                              HorizontalAlignment="Center" 
                              Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Viewbox>

        <!-- Close Button -->
        <Button Content="×" 
                Width="30" Height="30"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Margin="15"
                FontSize="18"
                FontWeight="Light"
                Foreground="White"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#30FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Resize Grip (Optional) -->
        <ResizeGrip HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom" 
                   Width="16" Height="16"
                   Margin="0,0,5,5"
                   Opacity="0.3"/>
    </Grid>
</Window>