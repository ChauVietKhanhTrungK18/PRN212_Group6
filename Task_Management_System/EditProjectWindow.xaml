<Window x:Class="Task_Management_System.EditProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Edit Project" Height="398" Width="428">
    <Grid Background="#f4f6fa">
        <StackPanel Margin="20,20,0,0">
            <TextBlock Text="Edit Project" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Project Name:" FontWeight="Bold"/>
            <TextBox x:Name="txtProjectName" Width="300" Margin="0,10,0,10"/>

            <TextBlock Text="Description:" FontWeight="Bold"/>
            <TextBox x:Name="txtDescription" Width="300" Margin="0,10,0,10"/>

            <TextBlock Text="Start Date:" FontWeight="Bold"/>
            <DatePicker x:Name="dpStartDate" Width="300" Margin="0,10,0,10"/>

            <TextBlock Text="End Date:" FontWeight="Bold"/>
            <DatePicker x:Name="dpEndDate" Width="300" Margin="0,10,0,20"/>

            <Button Content="Save Changes" Width="150" HorizontalAlignment="Center" Click="BtnSaveChanges_Click"/>
        </StackPanel>
    </Grid>
</Window>