<Window x:Class="Task_Management_System.EditProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Edit Project" Height="550" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Background="#f4f6fa" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Edit Project" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Project Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtProjectName" Height="30" Margin="0,0,0,15"/>

                <TextBlock Text="Description:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDescription" Height="80" TextWrapping="Wrap" 
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                <TextBlock Text="Start Date:" FontWeight="Bold" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpStartDate" Margin="0,0,0,15"/>

                <TextBlock Text="End Date:" FontWeight="Bold" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpEndDate" Margin="0,0,0,15"/>

                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbStatus" Height="30" Margin="0,0,0,15">
                    <ComboBoxItem Content="Not Started"/>
                    <ComboBoxItem Content="In Progress"/>
                    <ComboBoxItem Content="Completed"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Save Changes" Width="120" Height="35" Margin="5" 
                    Background="#28a745" Foreground="White" FontWeight="Bold" Click="BtnSaveChanges_Click"/>
            <Button Content="Cancel" Width="120" Height="35" Margin="5" 
                    Background="#6c757d" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
