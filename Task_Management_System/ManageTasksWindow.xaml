<Window x:Class="Task_Management_System.ManageTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
       Title="Manage Tasks" Height="400" Width="600">
    <Grid Background="#f4f6fa" Margin="0,0,-129,-16">
        <StackPanel Margin="20">
            <TextBlock Text="Manage Project Tasks" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Project Selection -->
            <ComboBox x:Name="cbProjects" Width="300" Margin="0,0,0,20" SelectionChanged="CbProjects_SelectionChanged"/>

            <!-- Task List -->
            <DataGrid x:Name="dgTasks" AutoGenerateColumns="False" Height="200" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Task Name" Binding="{Binding TaskName}" Width="200"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="300"/>
                    <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Add Task" Width="150" Margin="10" Click="BtnAddTask_Click"/>
                <Button Content="Remove Task" Width="150" Margin="10" Click="BtnRemoveTask_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>