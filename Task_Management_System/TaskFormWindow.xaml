<Window x:Class="Task_Management_System.TaskFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Form" Height="500" Width="600" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF9800" Padding="15,10" CornerRadius="5,5,0,0">
            <TextBlock x:Name="txtHeader" Text="Add New Task" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,20">
                <!-- Task Name -->
                <TextBlock Text="Task Name *" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTaskName" Height="30" Margin="0,0,0,15" FontSize="14" Padding="5"/>

                <!-- Description -->
                <TextBlock Text="Description *" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDescription" Height="80" Margin="0,0,0,15" FontSize="14" Padding="5" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <!-- Due Date -->
                <TextBlock Text="Due Date *" FontWeight="Bold" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpDueDate" Height="30" Margin="0,0,0,15" FontSize="14"/>

                <!-- Status -->
                <TextBlock Text="Status *" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cboStatus" Height="30" Margin="0,0,0,15" FontSize="14">
                    <ComboBoxItem Content="Not Started"/>
                    <ComboBoxItem Content="In Progress"/>
                    <ComboBoxItem Content="Completed"/>
                </ComboBox>

                <!-- Project -->
                <TextBlock Text="Project *" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cboProject" Height="30" Margin="0,0,0,15" FontSize="14" DisplayMemberPath="ProjectName"/>

                <!-- Validation Messages -->
                <TextBlock x:Name="txtValidation" Foreground="Red" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10" CornerRadius="0,0,5,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnSave" Content="Save" Width="100" Height="35" Background="#4CAF50" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,10,0" Click="BtnSave_Click"/>
                <Button x:Name="btnCancel" Content="Cancel" Width="100" Height="35" Background="#F44336" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 