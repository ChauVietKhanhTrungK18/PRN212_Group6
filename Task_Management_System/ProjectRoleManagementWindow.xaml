<Window x:Class="Task_Management_System.ProjectRoleManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Role Management" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#9C27B0" Padding="15,10" CornerRadius="5,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Project Role Management" 
                           FontSize="18" FontWeight="Bold" Foreground="White" 
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Close" Padding="15,5" 
                        Background="#FF5722" Foreground="White" BorderThickness="0"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- Project Info -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="15,10" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Project:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="txtProjectName" Text="Project Name" 
                           FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Grid.Column="2" Content="Add User to Project" Padding="10,5"
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        Click="BtnAddUserToProject_Click"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Project Roles List -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10">
                        <TextBlock Text="Project Members" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <!-- Roles DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="dgProjectRoles" AutoGenerateColumns="False" 
                              IsReadOnly="True" SelectionMode="Single" 
                              SelectionChanged="DgProjectRoles_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="70"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding User.FullName}" Width="150"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding User.Email}" Width="200"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role.RoleName}" Width="120"/>
                            <DataGridTextColumn Header="Role Description" Binding="{Binding Role.Description}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Action Panel -->
            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" Width="250">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Action Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10">
                        <TextBlock Text="Actions" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" Margin="10">
                        <Button x:Name="btnChangeRole" Content="Change Role" 
                                Height="40" Margin="0,5" FontSize="14"
                                Background="#FF9800" Foreground="White" BorderThickness="0"
                                Click="BtnChangeRole_Click" IsEnabled="False"/>

                        <Button x:Name="btnRemoveUser" Content="Remove User" 
                                Height="40" Margin="0,5" FontSize="14"
                                Background="#F44336" Foreground="White" BorderThickness="0"
                                Click="BtnRemoveUser_Click" IsEnabled="False"/>

                        <Separator Margin="0,20"/>

                        <TextBlock Text="Member Details" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="User:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtUserName" Text="-" Margin="0,0,0,10"/>

                        <TextBlock Text="Email:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtUserEmail" Text="-" Margin="0,0,0,10"/>

                        <TextBlock Text="Current Role:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtCurrentRole" Text="-" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="10,5" CornerRadius="0,0,5,5">
            <TextBlock x:Name="txtStatus" Text="Ready" Foreground="#666666"/>
        </Border>
    </Grid>
</Window> 