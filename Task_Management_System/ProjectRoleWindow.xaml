<Window x:Class="Task_Management_System.ProjectRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Role Management" Height="500" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Project"/>
                <ComboBox x:Name="cbProject" Width="180" DisplayMemberPath="ProjectName" SelectedValuePath="ProjectId"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="User"/>
                <ComboBox x:Name="cbUser" Width="180" DisplayMemberPath="FullName" SelectedValuePath="UserId"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Role"/>
                <ComboBox x:Name="cbRole" Width="160" DisplayMemberPath="RoleName" SelectedValuePath="RoleId"/>
            </StackPanel>
            <Button x:Name="btnAssign" Content="Assign Role" Width="110" Margin="10,22,0,0" Click="btnAssign_Click"/>
        </StackPanel>
        <DataGrid x:Name="dgProjectRoles" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User" Binding="{Binding User.FullName}" Width="2*"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role.RoleName}" Width="2*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Role.Description}" Width="3*"/>
                <DataGridTemplateColumn Header="Action" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" Click="btnRemove_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window> 