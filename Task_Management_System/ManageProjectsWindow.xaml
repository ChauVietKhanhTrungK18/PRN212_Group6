<Window x:Class="Task_Management_System.ManageProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Manage Projects" Height="600" Width="1000">
    <Grid Background="#f4f6fa" Margin="0,0,0,-16">
        <StackPanel Margin="20,20,10,10">
            <TextBlock Text="Manage Projects" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Search and Filters -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBox x:Name="txtSearch" Width="300" Height="30" TextChanged="txtSearch_TextChanged" 
                             VerticalAlignment="Center" Margin="0,0,20,0"/>
                </StackPanel>
                

            </Grid>

            <!-- Project List -->
            <DataGrid x:Name="dgProjects" AutoGenerateColumns="False" Height="350" IsReadOnly="True" 
                      SelectionMode="Single" GridLinesVisibility="All" HeadersVisibility="All"
                      AlternatingRowBackground="#f8f9fa" RowBackground="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project Name" Binding="{Binding ProjectName}" Width="200"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250"/>
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Created Date" Binding="{Binding DateCreated, StringFormat=dd/MM/yyyy}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Create Project" Width="150" Height="35" Margin="10" 
                        Background="#007bff" Foreground="White" Click="BtnCreateProject_Click"/>
                <Button Content="View Details" Width="150" Height="35" Margin="10" 
                        Background="#17a2b8" Foreground="White" Click="BtnViewDetails_Click"/>
                <Button Content="Edit Project" Width="150" Height="35" Margin="10" 
                        Background="#28a745" Foreground="White" Click="BtnEditProject_Click"/>
                <Button Content="Delete Project" Width="150" Height="35" Margin="10" 
                        Background="#dc3545" Foreground="White" Click="BtnDeleteProject_Click"/>
                <Button Content="Refresh" Width="150" Height="35" Margin="10" 
                        Background="#6c757d" Foreground="White" Click="BtnRefresh_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>