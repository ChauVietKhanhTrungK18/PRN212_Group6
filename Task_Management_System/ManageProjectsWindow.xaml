<Window x:Class="Task_Management_System.ManageProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Manage Projects" Height="432" Width="811">
    <Grid Background="#f4f6fa" Margin="0,0,0,-16">
        <StackPanel Margin="20,20,10,10">
            <TextBlock Text="Manage Projects" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Search and Filters -->
            <TextBox x:Name="txtSearch" Width="200" Height="30" TextChanged="txtSearch_TextChanged" Margin="0,0,0,10"/>

            <!-- Project List -->
            <DataGrid x:Name="dgProjects" AutoGenerateColumns="False" Height="200" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project Name" Binding="{Binding ProjectName}" Width="200"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="300"/>
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="100"/>
                    <DataGridTextColumn Header="End Date" Binding="{Binding EndDate}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Create Project" Width="150" Margin="10" Click="BtnCreateProject_Click"/>
                <Button Content="Edit Project" Width="150" Margin="10" Click="BtnEditProject_Click"/>
                <Button Content="Delete Project" Width="150" Margin="10" Click="BtnDeleteProject_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>