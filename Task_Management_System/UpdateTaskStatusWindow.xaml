<Window x:Class="Task_Management_System.UpdateTaskStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Task Status" Height="250" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#9C27B0" Padding="15,10" CornerRadius="5,5,0,0">
            <TextBlock Text="Update Task Status" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,20">
            <TextBlock Text="Select Status *" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cboStatus" Height="30" FontSize="14">
                <ComboBoxItem Content="Not Started"/>
                <ComboBoxItem Content="In Progress"/>
                <ComboBoxItem Content="Completed"/>
            </ComboBox>
            <TextBlock x:Name="txtValidation" Foreground="Red" FontWeight="Bold" Margin="0,10,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10" CornerRadius="0,0,5,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnUpdate" Content="Update" Width="100" Height="35" Background="#4CAF50" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,10,0" Click="BtnUpdate_Click"/>
                <Button x:Name="btnCancel" Content="Cancel" Width="100" Height="35" Background="#F44336" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 