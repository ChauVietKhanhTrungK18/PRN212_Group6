<Window x:Class="Task_Management_System.UpdateTaskStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Update Task Status" Height="500" Width="550" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Background="#f4f6fa" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Update Task Status" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtTaskInfo" Text="Task: " FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- Task Information -->
        <StackPanel Grid.Row="1">
            <GroupBox Header="Task Information" Margin="0,0,0,15">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Task Name:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock x:Name="txtTaskName" Grid.Row="0" Grid.Column="1" Margin="10,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock x:Name="txtDescription" Grid.Row="1" Grid.Column="1" Margin="10,5" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Deadline:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock x:Name="txtDeadline" Grid.Row="2" Grid.Column="1" Margin="10,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Current Status:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock x:Name="txtCurrentStatus" Grid.Row="3" Grid.Column="1" Margin="10,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="New Status:" FontWeight="Bold" Margin="0,5"/>
                    <ComboBox x:Name="cbNewStatus" Grid.Row="4" Grid.Column="1" Margin="10,5">
                        <ComboBoxItem Content="Not Started"/>
                        <ComboBoxItem Content="In Progress"/>
                        <ComboBoxItem Content="Completed"/>
                    </ComboBox>
                </Grid>
            </GroupBox>

            <GroupBox Header="Status Workflow" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <TextBlock Text="Status Progression:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Not Started → In Progress → Completed" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="You can also set status to 'On Hold' at any time." FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Update Status" Width="120" Height="35" Margin="5" 
                    Background="#28a745" Foreground="White" FontWeight="Bold" Click="BtnUpdateStatus_Click"/>
            <Button Content="Cancel" Width="120" Height="35" Margin="5" 
                    Background="#6c757d" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window> 