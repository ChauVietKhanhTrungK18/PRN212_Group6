<Window x:Class="Task_Management_System.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Add Task" Height="306" Width="400">
    <Grid Background="#f4f6fa" Margin="0,0,0,-16">
        <StackPanel Margin="20">
            <TextBlock Text="Add Task" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Task Name:" FontWeight="Bold"/>
            <TextBox x:Name="txtTaskName" Width="300" Margin="0,10,0,10"/>

            <TextBlock Text="Description:" FontWeight="Bold"/>
            <TextBox x:Name="txtDescription" Width="300" Margin="0,10,0,10"/>

            <TextBlock Text="Deadline:" FontWeight="Bold"/>
            <DatePicker x:Name="dpDeadline" Width="300" Margin="0,10,0,20"/>
            <Button Content="Add Task" Width="150" HorizontalAlignment="Center" Click="BtnAddTask_Click"/>
        </StackPanel>
    </Grid>
</Window>