<Window x:Class="Task_Management_System.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Project Management" Height="700" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#4CAF50" Padding="15,10" CornerRadius="5,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Project Management" 
                           FontSize="20" FontWeight="Bold" Foreground="White" 
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Close" Padding="15,5" 
                        Background="#FF5722" Foreground="White" BorderThickness="0"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Project List -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Project List Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Project List" 
                                       FontSize="16" FontWeight="Bold"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Refresh" Padding="10,5" Margin="0,0,5,0"
                                        Background="#2196F3" Foreground="White" BorderThickness="0"
                                        Click="BtnRefresh_Click"/>
                                <Button Content="Add New Project" Padding="10,5"
                                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                                        Click="BtnAddProject_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Project DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="dgProjects" AutoGenerateColumns="False" 
                              IsReadOnly="True" SelectionMode="Single" 
                              SelectionChanged="DgProjects_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProjectId}" Width="50"/>
                            <DataGridTextColumn Header="Project Name" Binding="{Binding ProjectName}" Width="200"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250"/>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Manager" Binding="{Binding Manager.FullName}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Action Panel -->
            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" Width="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Action Header -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10">
                        <TextBlock Text="Actions" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" Margin="10">
                        <Button x:Name="btnEditProject" Content="Edit Project" 
                                Height="40" Margin="0,5" FontSize="14"
                                Background="#FF9800" Foreground="White" BorderThickness="0"
                                Click="BtnEditProject_Click" IsEnabled="False"/>

                        <Button x:Name="btnDeleteProject" Content="Delete Project" 
                                Height="40" Margin="0,5" FontSize="14"
                                Background="#F44336" Foreground="White" BorderThickness="0"
                                Click="BtnDeleteProject_Click" IsEnabled="False"/>

                        <Button x:Name="btnManageRoles" Content="Manage Project Roles" 
                                Height="40" Margin="0,5" FontSize="14"
                                Background="#9C27B0" Foreground="White" BorderThickness="0"
                                Click="BtnManageRoles_Click" IsEnabled="False"/>

                        <Separator Margin="0,20"/>

                        <TextBlock Text="Project Details" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Project Name:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtProjectName" Text="-" Margin="0,0,0,10"/>

                        <TextBlock Text="Description:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtDescription" Text="-" Margin="0,0,0,10"/>

                        <TextBlock Text="Start Date:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtStartDate" Text="-" Margin="0,0,0,10"/>

                        <TextBlock Text="End Date:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtEndDate" Text="-" Margin="0,0,0,10"/>

                        <TextBlock Text="Status:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtProjectStatus" Text="-" Margin="0,0,0,10"/>

                        <TextBlock Text="Manager:" FontWeight="Bold"/>
                        <TextBlock x:Name="txtManager" Text="-" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10,5" CornerRadius="0,0,5,5">
            <TextBlock x:Name="txtStatus" Text="Ready" Foreground="#666666"/>
        </Border>
    </Grid>
</Window> 