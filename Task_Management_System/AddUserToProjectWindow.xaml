<Window x:Class="Task_Management_System.AddUserToProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add User to Project" Height="400" Width="500" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#4CAF50" Padding="15,10" CornerRadius="5,5,0,0">
            <TextBlock Text="Add User to Project" 
                       FontSize="18" FontWeight="Bold" Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Form Content -->
        <StackPanel Grid.Row="1" Margin="0,20">
            <!-- Project Info -->
            <TextBlock Text="Project:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtProjectName" Text="Project Name" 
                       FontWeight="Bold" Margin="0,0,0,20" Foreground="#2196F3"/>

            <!-- User Selection -->
            <TextBlock Text="Select User *" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cboUser" Height="30" Margin="0,0,0,15" 
                      FontSize="14" DisplayMemberPath="FullName"/>

            <!-- Role Selection -->
            <TextBlock Text="Select Role *" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cboRole" Height="30" Margin="0,0,0,15" 
                      FontSize="14" DisplayMemberPath="RoleName"/>

            <!-- Available Users List -->
            <TextBlock Text="Available Users:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox x:Name="lstAvailableUsers" Height="150" Margin="0,0,0,15"
                     DisplayMemberPath="FullName" SelectionChanged="LstAvailableUsers_SelectionChanged"/>

            <!-- Validation Messages -->
            <TextBlock x:Name="txtValidation" Foreground="Red" FontWeight="Bold" 
                       Margin="0,0,0,10" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10" CornerRadius="0,0,5,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnAdd" Content="Add User" Width="100" Height="35" 
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btnCancel" Content="Cancel" Width="100" Height="35" 
                        Background="#F44336" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 