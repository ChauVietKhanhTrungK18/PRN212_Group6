<Window x:Class="Task_Management_System.ManageAttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Manage Attachments" Height="600" Width="800">
    <Grid Background="#f4f6fa" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="txtTitle" Text="Manage Attachments" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtInfo" Text="Project/Task: " FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- Upload Section -->
        <GroupBox Grid.Row="1" Header="Upload Files" Margin="0,0,0,20">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Select Files:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <Button Content="Browse Files" Width="120" Height="30" Margin="10,0" 
                            Background="#007bff" Foreground="White" Click="BtnBrowseFiles_Click"/>
                    <TextBlock x:Name="txtSelectedFiles" Text="No files selected" VerticalAlignment="Center" 
                               Margin="10,0" Foreground="Gray"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Upload Files" Width="120" Height="30" 
                        Background="#28a745" Foreground="White" Click="BtnUploadFiles_Click"/>
            </Grid>
        </GroupBox>

        <!-- File List -->
        <GroupBox Grid.Row="2" Header="Attached Files">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBox x:Name="txtSearch" Width="200" Height="25" TextChanged="txtSearch_TextChanged"/>
                </StackPanel>

                <DataGrid x:Name="dgAttachments" Grid.Row="1" AutoGenerateColumns="False" 
                          IsReadOnly="True" SelectionMode="Single" Height="300"
                          GridLinesVisibility="All" HeadersVisibility="All"
                          AlternatingRowBackground="#f8f9fa" RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="200"/>
                        <DataGridTextColumn Header="Uploaded By" Binding="{Binding UploadedByUser.FullName}" Width="150"/>
                        <DataGridTextColumn Header="Upload Date" Binding="{Binding DateUploaded, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                        <DataGridTextColumn Header="File Size" Binding="{Binding FileSize}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Download" Width="120" Height="35" Margin="5" 
                    Background="#17a2b8" Foreground="White" Click="BtnDownload_Click"/>
            <Button Content="Delete" Width="120" Height="35" Margin="5" 
                    Background="#dc3545" Foreground="White" Click="BtnDelete_Click"/>
            <Button Content="Refresh" Width="120" Height="35" Margin="5" 
                    Background="#6c757d" Foreground="White" Click="BtnRefresh_Click"/>
            <Button Content="Close" Width="120" Height="35" Margin="5" 
                    Background="#6c757d" Foreground="White" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window> 