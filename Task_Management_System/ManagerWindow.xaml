<Window x:Class="Task_Management_System.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Dashboard" Height="800" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Background="#f4f6fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and Navigation -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="20,20,20,10">
            <Button x:Name="btnLogout" Content="Logout" Width="80" DockPanel.Dock="Right" HorizontalAlignment="Right" 
                    Margin="10,10,10,0" Click="BtnLogout_Click" Background="#dc3545" Foreground="White" FontWeight="Bold"/>
            <TextBlock Text="Manager Dashboard" FontSize="28" FontWeight="Bold" DockPanel.Dock="Left" Margin="10,10,10,10"/>
        </DockPanel>

        <!-- Dashboard Section -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="20,10,20,20" Padding="20">
            <StackPanel>
                <TextBlock Text="Dashboard Overview" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <!-- Stats Display Section -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    <Border Background="#0078d7" CornerRadius="6" Padding="20,15" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="24" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Total Projects" FontSize="12" Foreground="White" Opacity="0.8"/>
                                <TextBlock x:Name="txtTotalProjects" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#43b581" CornerRadius="6" Padding="20,15" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="24" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Total Tasks" FontSize="12" Foreground="White" Opacity="0.8"/>
                                <TextBlock x:Name="txtTotalTasks" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#fbbc05" CornerRadius="6" Padding="20,15" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="24" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Total Members" FontSize="12" Foreground="White" Opacity="0.8"/>
                                <TextBlock x:Name="txtTotalMembers" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Project Management Section -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="20,0,20,10" Padding="20">
            <StackPanel>
                <TextBlock Text="Project Management" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <!-- Search and Actions -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Search Projects:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox x:Name="txtSearch" Width="250" Height="30" TextChanged="txtSearch_TextChanged" 
                                 VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <TextBlock Text="Status Filter:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <ComboBox x:Name="cbStatusFilter" Width="120" Height="30" SelectionChanged="cbStatusFilter_SelectionChanged">
                            <ComboBoxItem Content="All Projects" IsSelected="True"/>
                            <ComboBoxItem Content="Not Started"/>
                            <ComboBoxItem Content="In Progress"/>
                            <ComboBoxItem Content="Completed"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Create Project" Width="120" Height="35" Margin="5" 
                                Background="#007bff" Foreground="White" FontWeight="Bold" Click="BtnCreateProject_Click"/>
                        <Button Content="Refresh" Width="80" Height="35" Margin="5" 
                                Background="#6c757d" Foreground="White" FontWeight="Bold" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Project DataGrid -->
                <DataGrid x:Name="dgProjects" AutoGenerateColumns="False" Height="250" IsReadOnly="True" 
                          SelectionMode="Single" CanUserAddRows="False" GridLinesVisibility="All" 
                          HeadersVisibility="All" AlternatingRowBackground="#f8f9fa" RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Project Name" Binding="{Binding ProjectName}" Width="200"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250"/>
                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Created Date" Binding="{Binding DateCreated, StringFormat=dd/MM/yyyy}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="View Project Details" Width="150" Height="40" Margin="10" 
                    Background="#17a2b8" Foreground="White" FontWeight="Bold" Click="BtnViewDetails_Click"/>
            <Button Content="Edit Project" Width="150" Height="40" Margin="10" 
                    Background="#28a745" Foreground="White" FontWeight="Bold" Click="BtnEditProject_Click"/>
            <Button Content="Delete Project" Width="150" Height="40" Margin="10" 
                    Background="#dc3545" Foreground="White" FontWeight="Bold" Click="BtnDeleteProject_Click"/>
            <Button Content="Manage Members" Width="150" Height="40" Margin="10" 
                    Background="#ffc107" Foreground="Black" FontWeight="Bold" Click="BtnManageMembers_Click"/>
            <Button Content="Manage Tasks" Width="150" Height="40" Margin="10" 
                    Background="#6f42c1" Foreground="White" FontWeight="Bold" Click="BtnManageTasks_Click"/>
        </StackPanel>
    </Grid>
</Window>
