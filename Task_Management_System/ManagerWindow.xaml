<Window x:Class="Task_Management_System.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Dashboard" Height="700" Width="950">
    <Grid Background="#f4f6fa">
        <!-- Header and Navigation -->
        <DockPanel LastChildFill="True" Margin="20">
            <Button x:Name="btnLogout" Content="Logout" Width="80" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="10,10,10,0" Click="BtnLogout_Click"/>
            <TextBlock Text="Manager Dashboard" FontSize="28" FontWeight="Bold" DockPanel.Dock="Left" Margin="10,10,10,10"/>
        </DockPanel>

        <!-- Main content -->
        <StackPanel Margin="20,20,20,-41">
            <!-- Dashboard Section -->
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Stats Display Section -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,20,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Total Projects: " FontSize="16" Width="200"/>
                    <TextBlock x:Name="txtTotalProjects" FontSize="16" FontWeight="Bold" Foreground="#0078d7"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Total Tasks: " FontSize="16" Width="200"/>
                    <TextBlock x:Name="txtTotalTasks" FontSize="16" FontWeight="Bold" Foreground="#43b581"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Total Members: " FontSize="16" Width="200"/>
                    <TextBlock x:Name="txtTotalMembers" FontSize="16" FontWeight="Bold" Foreground="#fbbc05"/>
                </StackPanel>
            </StackPanel>

            <!-- Project Search -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <!-- Search Box -->
                <StackPanel Orientation="Vertical" Margin="10,0,0,0">
                    <TextBlock Text="Search by Project Name/Description" FontWeight="Bold"/>
                    <TextBox x:Name="txtSearch" Width="200" Height="30" TextChanged="txtSearch_TextChanged"/>
                </StackPanel>
            </StackPanel>

            <!-- Project DataGrid -->
            <TextBlock Text="Projects List" FontSize="24" FontWeight="Bold" Margin="20,20,0,10"/>
            <DataGrid x:Name="dgProjects" AutoGenerateColumns="False"
                      Height="300" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project Name" Binding="{Binding ProjectName}" Width="200"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="300"/>
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="100"/>
                    <DataGridTextColumn Header="End Date" Binding="{Binding EndDate}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Manage Projects" Width="150" Margin="10" Click="BtnManageProjects_Click"/>
                <Button Content="Manage Members" Width="150" Margin="10" Click="BtnManageMembers_Click"/>
                <Button Content="Manage Tasks" Width="150" Margin="10" Click="BtnManageTasks_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
