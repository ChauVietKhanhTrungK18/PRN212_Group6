<Window x:Class="Task_Management_System.ProjectDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Project Details" Height="600" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Background="#f4f6fa" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="txtProjectTitle" Text="Project Details" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtProjectStatus" Text="Status: " FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <!-- Project Information -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Project Information" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="Bold" Margin="0,5"/>
                        <TextBlock x:Name="txtProjectName" Grid.Row="0" Grid.Column="1" Margin="10,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" FontWeight="Bold" Margin="0,5"/>
                        <TextBlock x:Name="txtProjectDescription" Grid.Row="1" Grid.Column="1" Margin="10,5" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Start Date:" FontWeight="Bold" Margin="0,5"/>
                        <TextBlock x:Name="txtStartDate" Grid.Row="2" Grid.Column="1" Margin="10,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="End Date:" FontWeight="Bold" Margin="0,5"/>
                        <TextBlock x:Name="txtEndDate" Grid.Row="3" Grid.Column="1" Margin="10,5"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Created Date:" FontWeight="Bold" Margin="0,5"/>
                        <TextBlock x:Name="txtCreatedDate" Grid.Row="4" Grid.Column="1" Margin="10,5"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Project Statistics" Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Total Tasks" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtTotalTasks" Text="0" FontSize="24" HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Completed Tasks" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtCompletedTasks" Text="0" FontSize="24" HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Team Members" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtTeamMembers" Text="0" FontSize="24" HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Close" Width="120" Height="35" Margin="5" 
                    Background="#6c757d" Foreground="White" FontWeight="Bold" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window> 