<Window x:Class="Task_Management_System.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="230" Width="400">
    <Grid Background="#f4f6fa" Margin="0">
        <Border Background="#fff" CornerRadius="12" Padding="24" Margin="20">
            <StackPanel>
                <TextBlock Text="Change Password" FontSize="22" FontWeight="Bold" Foreground="#2d3a4a" Margin="0,0,0,18"/>
                <TextBlock Text="Old Password"/>
                <PasswordBox x:Name="txtOldPassword" Margin="0,0,0,10"/>
                <TextBlock Text="New Password"/>
                <PasswordBox x:Name="txtNewPassword" Margin="0,0,0,10"/>
                <TextBlock Text="Confirm New Password"/>
                <PasswordBox x:Name="txtConfirmPassword" Margin="0,0,0,18"/>
                <Button Content="Save" x:Name="btnSave" Height="36" Click="btnSave_Click" Background="#0078d7" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window> 