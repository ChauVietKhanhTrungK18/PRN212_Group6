<Window x:Class="Task_Management_System.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Change Password" Height="602" Width="476" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#f4f6fa" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Change Password" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Please enter your current password and new password" FontSize="14" HorizontalAlignment="Center" Foreground="#7f8c8d"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <GroupBox Header="Password Information" Margin="0,0,0,20">
                <StackPanel Margin="15">
                    <TextBlock Text="Current Password:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtCurrentPassword" Height="35" Margin="0,0,0,15" FontSize="14"/>

                    <TextBlock Text="New Password:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtNewPassword" Height="35" Margin="0,0,0,15" FontSize="14"/>

                    <TextBlock Text="Confirm New Password:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtConfirmPassword" Height="35" Margin="0,0,0,15" FontSize="14"/>
                </StackPanel>
            </GroupBox>


        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Change Password" Width="150" Height="40" Margin="10" 
                    Background="#27ae60" Foreground="White" FontWeight="Bold" Click="BtnChangePassword_Click"/>
            <Button Content="Cancel" Width="100" Height="40" Margin="10" 
                    Background="#95a5a6" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window> 