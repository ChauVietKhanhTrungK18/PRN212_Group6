<Window x:Class="Task_Management_System.ManageMembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Manage Project Members" Height="500" Width="700" WindowStartupLocation="CenterScreen">
    <Grid Background="#f4f6fa" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="txtProjectTitle" Grid.Row="0" Text="Manage Project Members" FontSize="24" FontWeight="Bold" 
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <!-- Refresh Button -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
            <Button Content="Refresh" Width="80" Height="35" 
                    Background="#17a2b8" Foreground="White" FontWeight="Bold" Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- Member List -->
        <DataGrid x:Name="dgMembers" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionMode="Single" Margin="0,0,0,20"
                  GridLinesVisibility="All" HeadersVisibility="All"
                  AlternatingRowBackground="#f8f9fa" RowBackground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="250"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Add Member" Width="150" Height="40" Margin="10" 
                    Background="#28a745" Foreground="White" FontWeight="Bold" Click="BtnAddMember_Click"/>
            <Button Content="Remove Member" Width="150" Height="40" Margin="10" 
                    Background="#dc3545" Foreground="White" FontWeight="Bold" Click="BtnRemoveMember_Click"/>
        </StackPanel>
    </Grid>
</Window>