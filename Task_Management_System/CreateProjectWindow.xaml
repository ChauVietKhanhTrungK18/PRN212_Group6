<Window x:Class="Task_Management_System.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Create Project" Height="700" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Background="#f4f6fa" Margin="20">
        <StackPanel Margin="10,20,10,20">
            <TextBlock Text="Create Project" FontSize="28" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <TextBlock Text="Project Name:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtProjectName" Height="30" Margin="0,0,0,15"/>

            <TextBlock Text="Description:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDescription" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

            <TextBlock Text="Start Date:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpStartDate" Height="30" Margin="0,0,0,15" 
                        SelectedDateChanged="dpStartDate_SelectedDateChanged"/>

            <TextBlock Text="End Date:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpEndDate" Height="30" Margin="0,0,0,15" 
                        SelectedDateChanged="dpEndDate_SelectedDateChanged"/>

            <TextBlock Text="Project Status (Auto-determined):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtStatusPreview" Text="Not Started" FontSize="12" Foreground="#666" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Create Project" Width="120" Height="35" Margin="10" Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="BtnCreateProject_Click"/>
                <Button Content="Cancel" Width="120" Height="35" Margin="10" Background="#f44336" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
