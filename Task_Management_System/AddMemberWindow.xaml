<Window x:Class="Task_Management_System.AddMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task_Management_System"
        mc:Ignorable="d"
        Title="Add Member to Project" Height="300" Width="400">
    <Grid Background="#f4f6fa">
        <StackPanel Margin="20">
            <TextBlock Text="Add Member to Project" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- User Selection -->
            <ComboBox x:Name="cbUsers" Width="300" Margin="0,0,0,20"/>

            <!-- Add Member Button -->
            <Button Content="Add Member" Width="150" HorizontalAlignment="Center" Click="BtnAddMember_Click"/>
        </StackPanel>
    </Grid>
</Window>
